}

h1 {
    color: #333;
}

form {
    margin-top: 20px;
}

input[type="file"] {
    margin-right: 10px;
    padding: 10px;
}

button {
    padding: 10px 20px;
    background-color: #4caf50;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

h2 {
    margin-top: 20px;
