}


/* static/style.css */

/* ... (existing styles) */

.header {
    background-color: #4caf50;
    color: #fff;
    padding: 20px;
    text-align: center;
    margin-bottom: 100px;
}

.header h1 {
    margin: 0;
}

.footer {
    text-align: center;
    /* margin-top: 30px; */
