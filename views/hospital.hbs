    function recommendHospital() {
      var locationSelect = document.getElementById("locationSelect");
      var location = locationSelect.value;
      var hospitalList = document.getElementById("hospitalList");
      hospitalList.innerHTML = "";

      if (location in hospitals) {
        var hospitalArray = hospitals[location];
        var ul = document.createElement("ul");
        hospitalArray.forEach(function(hospital) {
          var li = document.createElement("li");
          var link = document.createElement("a");
          link.href = "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(hospital.address);
          var linkText = `${hospital.name} <br> Address: ${hospital.address}, Contact: ${hospital.contact}`;
          link.innerHTML = linkText;
          link.target = "_blank";
          li.appendChild(link);
          ul.appendChild(li);
        });
        hospitalList.appendChild(ul);
      } else {
        hospitalList.textContent = "No hospitals found for this location.";
      }
    }
