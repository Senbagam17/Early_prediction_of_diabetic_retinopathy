<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diabetic Retinopathy Medication Recommendation</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-image: url("bg.avif");
            background-repeat: no-repeat;
            background-size: cover;
            background-attachment: fixed;
            height: 100vh;
            width: 100%;
            
        }
        .container {
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }
        h1 {
            color: #333333;
            text-align: center;
            margin-bottom: 30px;
            text-transform: uppercase;
        }
        form {
            text-align: center;
            margin-bottom: 30px;
        }
        label {
            display: block;
            margin-bottom: 10px;
            color: #555555;
            font-weight: bold;
        }
        select {
            width: 100%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ced4da;
            margin-bottom: 20px;
            background-color: #f3f4f6;
            color: #555555;
            font-size: 16px;
        }
        button {
            padding: 10px 20px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            font-size: 16px;
        }
        button:hover {
            background-color: #218838;
        }
        .dropdown {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            padding: 12px 16px;
            z-index: 1;
            border-radius: 5px;
        }
        .dropdown:hover .dropdown-content {
            display: block;
        }
        .detailed-explanation {
            margin-top: 10px;
            background-color: #f3f4f6;
            padding: 10px;
            border-radius: 5px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #ffffff; /* Adjust background color as needed */
            color: #0c0b0b;
            padding: 10px 20px;
        }
        .navbar {
    overflow: hidden;
    background-color: #000000;
    height: 100px;
   
    display: flex;
    justify-content: center; /* Center content horizontally */
    align-items: center; /* Center content vertically */
}
.navbar a {
    display: inline-block;
    color: #f2f2f2;
    text-align: center;
    padding: 14px 20px;
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s, transform 0.3s, box-shadow 0.3s, border-radius 0.3s; /* Added border-radius transition */
    border-radius: 20px; /* Rounded corners */
    box-shadow: 0 0 10px rgba(0,0,0,0.5); /* Initial glow effect */
}
.navbar a:hover {
    background-color: #ffffff;
    color: #000000;
    transform: scale(1.05); /* Slightly scale up */
    box-shadow: 0 0 15px rgba(255,255,255,0.7); /* Enhanced glow effect */
    border-radius: 25px; /* Slightly increased border-radius on hover */
}
        .error {
            color: red;
        }
        .navbar a.active {
            background-color: #4CAF50;
            color: white;
        }
    </style>
</head>
<body>
     <div class="header">
        <div>DR Vision</div>
        <div>Contact Us</div>
    </div>
     <div class="navbar">
        <a href="/home">Home</a>
        <a href="/category">Category</a>
        <a href="/checkup">Check-Up</a>
        <a href="/Profile">Patient Profile</a>
        <a href="/hospital">Hospital</a>
        <a class="active" href="#medication">Medication</a>
        
    </div>
   <div class="container">
        <h1>Diabetic Retinopathy Medication Recommendation</h1>
       <form id="stageForm">
            <label for="stageSelect">Select Stage:</label>
            <select id="stageSelect">
                <option value="Mild">Mild</option>
                <option value="Moderate">Moderate</option>
                <option value="Severe">Severe</option>
                <option value="Proliferative">Proliferative</option>
            </select>
            <button type="button" onclick="toggleDetailedExplanation()">Show Detailed Explanation</button>
        </form>
        </div>

        <div id="medicationResult"></div>
    

    <script>
        var medications = {
            "Mild": ["Regular eye exams to monitor progress", "Control blood sugar levels through diet, exercise, and/or medication", "Control blood pressure to reduce strain on the blood vessels in the eye"],
            "Moderate": ["Continue controlling blood sugar levels and blood pressure", "Anti-VEGF injections to reduce swelling and prevent new blood vessel growth"],
            "Severe": ["Laser therapy to shrink abnormal blood vessels and reduce swelling", "Anti-VEGF injections to prevent new blood vessel growth", "Steroid injections to reduce inflammation and swelling", "Maintain strict control of blood sugar levels and blood pressure"],
            "Proliferative": ["Laser therapy to prevent further growth of abnormal blood vessels and reduce bleeding", "Vitrectomy surgery to remove scar tissue and blood from the vitreous gel", "Anti-VEGF injections to prevent new blood vessel growth", "Steroid injections to reduce inflammation", "Strict control of blood sugar levels and blood pressure"]
        };

        var detailedExplanations = {
            "Regular eye exams to monitor progress": "Regular eye exams are essential to monitor the progress of diabetic retinopathy. These exams help detect any changes in the retina early on, allowing for timely intervention and management of the condition.",
            "Control blood sugar levels through diet, exercise, and/or medication": "Maintaining stable blood sugar levels is crucial in managing diabetic retinopathy. This can be achieved through a combination of dietary modifications, regular exercise, and medication as prescribed by a healthcare professional.",
            "Control blood pressure to reduce strain on the blood vessels in the eye": "Controlling blood pressure helps reduce strain on the blood vessels in the eye, which can slow the progression of diabetic retinopathy and decrease the risk of vision loss.",
            "Continue controlling blood sugar levels and blood pressure": "Continued management of blood sugar levels and blood pressure is essential to prevent further damage to the retina and reduce the risk of complications.",
            "Anti-VEGF injections to reduce swelling and prevent new blood vessel growth": "Anti-VEGF injections help reduce swelling and prevent the growth of new abnormal blood vessels in the retina, which can improve vision and slow the progression of diabetic retinopathy.",
            "Laser therapy to shrink abnormal blood vessels and reduce swelling": "Laser therapy is used to target and shrink abnormal blood vessels in the retina, reducing swelling and preventing further damage to the eye.",
            "Steroid injections to reduce inflammation and swelling": "Steroid injections help reduce inflammation and swelling in the retina, which can improve vision and slow the progression of diabetic retinopathy.",
            "Maintain strict control of blood sugar levels and blood pressure": "Maintaining strict control of blood sugar levels and blood pressure is crucial in managing diabetic retinopathy and reducing the risk of vision loss.",
            "Vitrectomy surgery to remove scar tissue and blood from the vitreous gel": "Vitrectomy surgery is a procedure to remove scar tissue and blood from the vitreous gel in the eye, which can improve vision and prevent further complications."
        };

        function toggleDetailedExplanation() {
            var medicationResult = document.getElementById("medicationResult");
            var stageSelect = document.getElementById("stageSelect");
            var stage = stageSelect.value;

            if (stage in medications) {
                var medicationList = medications[stage];
                var ul = document.createElement("ul");
                medicationList.forEach(function(medication) {
                    var li = document.createElement("li");
                    var dropdown = document.createElement("div");
                    dropdown.className = "dropdown";
                    dropdown.addEventListener("click", function() {
                        this.querySelector(".dropdown-content").classList.toggle("show");
                    });
                    var textNode = document.createTextNode(medication);
                    var detailedExplanation = document.createElement("div");
                    detailedExplanation.className = "dropdown-content";
                    detailedExplanation.textContent = detailedExplanations[medication];
                    dropdown.appendChild(textNode);
                    dropdown.appendChild(detailedExplanation);
                    li.appendChild(dropdown);
                    ul.appendChild(li);
                });
                medicationResult.innerHTML = "";
                medicationResult.appendChild(ul);
            } else {
                medicationResult.textContent = "No specific medication recommendation for this stage";
            }
        }
    </script>
</body>
</html>

