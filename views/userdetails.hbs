<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        h1 {
            text-align: center;
            margin-bottom: 20px;
        }
        .user-details {
            width: 400px;
            margin: 0 auto;
            border: 1px solid #ccc;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .user-details p {
            margin: 10px 0;
        }
        .btn-container {
            text-align: center;
            margin-top: 20px;
        }
        .btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #ffffff; /* Adjust background color as needed */
            color: #0c0b0b;
            padding: 10px 20px;
        }
        .navbar {
    overflow: hidden;
    background-color: #000000;
    height: 100px;
   
    display: flex;
    justify-content: center; /* Center content horizontally */
    align-items: center; /* Center content vertically */
}
.navbar a {
    display: inline-block;
    color: #f2f2f2;
    text-align: center;
    padding: 14px 20px;
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s, transform 0.3s, box-shadow 0.3s, border-radius 0.3s; /* Added border-radius transition */
    border-radius: 20px; /* Rounded corners */
    box-shadow: 0 0 10px rgba(0,0,0,0.5); /* Initial glow effect */
}
.navbar a:hover {
    background-color: #ffffff;
    color: #000000;
    transform: scale(1.05); /* Slightly scale up */
    box-shadow: 0 0 15px rgba(255,255,255,0.7); /* Enhanced glow effect */
    border-radius: 25px; /* Slightly increased border-radius on hover */
}
        .error {
            color: red;
        }
        .navbar a.active {
            background-color: #4CAF50;
            color: white;
        }
    </style>

</head>
<body>
     <div class="header">
        <div>DR Vision</div>
        <div>Contact Us</div>
    </div>
     <div class="navbar">
        <a class="active" href="#home">Home</a>
        <a href="/category">Category</a>
        <a href="/checkup">Check-Up</a>
        <a href="/Profile">Patient Profile</a>
        <a href="/hospital">Hospital</a>
        <a href="/medication">Medication</a>
        
    </div>
  <form action="/Profile" method="get">
    <h1>User Details</h1>
    <div class="user-details">
        <p><strong>Name:</strong> {{ user.fullName }}</p>
        <p><strong>Date of Birth:</strong> {{ user.dateOfBirth }}</p>
        <p><strong>Gender:</strong> {{ user.gender }}</p>
        <p><strong>Address:</strong> {{ user.address }}</p>
        <p><strong>Phone Number:</strong> {{ user.phoneNumber }}</p>
        <p><strong>Email:</strong> {{ user.email }}</p>
        <p><strong>Medical Conditions:</strong> {{ user.medicalConditions }}</p>
        <p><strong>Past Surgeries:</strong> {{ user.pastSurgeries }}</p>
        <p><strong>Family History:</strong> {{ user.familyHistory }}</p>
        <p><strong>Diabetes Type:</strong> {{ user.diabetesType }}</p>
        <p><strong>Diabetes Duration:</strong> {{ user.diabetesDuration }}</p>
        <p><strong>Treatment Plan:</strong> {{ user.treatmentPlan }}</p>
        <p><strong>Visual Symptoms:</strong> {{ user.visualSymptoms }}</p>
        <p><strong>Eye Examination History:</strong> {{ user.eyeExaminationHistory }}</p>
    </div>
    <div class="btn-container">
        <button type="submit" class="btn">Edit</button>
    </div>
    </form>
    
</body>
</html>
